{
  "name": "dsh-multi-agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @dsh/agent-manager build:client",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo:comm": "tsx examples/basic-communication.ts",
    "demo:agent": "tsx examples/sub-agent-lifecycle.ts",
    "demo:run": "tsx examples/run-lifecycle.ts",
    "lint": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "dsh:call-role": "tsx examples/call-role.ts",
    "dsh:compare-roles": "tsx examples/compare-roles.ts",
    "dsh:eval-bundle": "tsx examples/eval-bundle.ts",
    "dsh:start-workflow": "tsx examples/start-workflow.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@dsh/agent-manager": "workspace:*",
    "@dsh/comm-eventbus": "workspace:*",
    "@dsh/communication": "workspace:*",
    "@dsh/core": "workspace:*",
    "@dsh/orchestrator": "workspace:*",
    "@dsh/role-eval": "workspace:*",
    "@dsh/workspace-git": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
